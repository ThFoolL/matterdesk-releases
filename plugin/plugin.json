{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "matterdesk",
  "version": "0.21.0-beta.12",
  "description": "把飞书里的讨论，整理成桌面上清楚的待办",
  "homepage": "https://github.com/ThFoolL/matterdesk-releases",
  "repository": "https://github.com/ThFoolL/matterdesk-releases",
  "keywords": [
    "productivity",
    "feishu",
    "desktop"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "MatterDesk 事序",
        "shortDescription": "把飞书里的讨论，整理成桌面上清楚的待办",
        "longDescription": "同一件事的消息和文档放在一起，具体待办归到事项下面。按你关注的工作区分待办与通知，用对话调整分类习惯，在桌面便签或分栏看板里随时跟进。首次设置后默认随 Codex 自动启动，也可从 Codex 内的「事序悬浮窗」入口再次打开。",
        "developerName": "ThFoolL",
        "websiteURL": "https://github.com/ThFoolL/matterdesk-releases",
        "privacyPolicyURL": "https://github.com/ThFoolL/matterdesk-releases/blob/main/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/ThFoolL/matterdesk-releases/blob/main/LICENSE",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "screenshots": [
          "./assets/preview.png"
        ],
        "category": "Productivity"
      }
    }
  }
}
